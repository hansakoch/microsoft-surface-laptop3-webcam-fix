#!/usr/bin/env bash
# Lazy bridge for the OV9734 webcam loopback (/dev/video20).
#
# Runs as a systemd user service. Keeps the gst pipewire->loopback bridge
# running while Omarchy's screen-recorder-with-webcam flow is active, and
# stops it otherwise — so Google Meet / Chromium can use the camera when the
# recorder is not in use. No manual steps required.
set -u

DEVICE=/dev/video20
BRIDGE_PID=""

# Avoid `pgrep -f`: on this machine each full cmdline scan costs ~150ms because
# Chromium argv is huge. Reading /proc/*/comm is cheap; only open cmdline for
# processes that could actually be the recorder/overlay.
need_bridge() {
    local pid comm cmd
    for pid in /proc/[0-9]*; do
        [[ -r $pid/comm ]] || continue
        read -r comm < "$pid/comm" || continue
        case $comm in
            bash|mpv|gpu-screen-recorder|wf-recorder|wl-screenrec|ffmpeg|gst-launch-1.0)
                cmd=$(tr '\0' ' ' < "$pid/cmdline" 2>/dev/null) || continue
                case $cmd in
                    *screenrecording-with-webcam*|*WebcamOverlay*|*--with-webcam*)
                        return 0
                        ;;
                esac
                ;;
        esac
    done
    return 1
}

bridge_alive() {
    [[ -n "${BRIDGE_PID:-}" ]] && kill -0 "$BRIDGE_PID" 2>/dev/null
}

start_bridge() {
    bridge_alive && return 0
    [[ -e "$DEVICE" ]] || return 0   # module not loaded; nothing we can do here

    gst-launch-1.0 -q \
        pipewiresrc target-object="libcamera_input.__SB_.PCI0.I2C2.CAMF" \
        ! "video/x-raw,format=NV12,width=1280,height=704" \
        ! videoscale ! videoconvert \
        ! "video/x-raw,format=YUY2,width=1280,height=720" \
        ! v4l2sink device="$DEVICE" >/dev/null 2>&1 &
    BRIDGE_PID=$!
}

stop_bridge() {
    if bridge_alive; then
        kill "$BRIDGE_PID" 2>/dev/null
        wait "$BRIDGE_PID" 2>/dev/null
    fi
    BRIDGE_PID=""
}

trap stop_bridge EXIT

while true; do
    if need_bridge; then
        start_bridge
    else
        stop_bridge
    fi
    sleep 5
done
