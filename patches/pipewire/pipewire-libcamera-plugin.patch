+		sc.size = frameSize;
+		CameraConfiguration::Status status = impl->config->validate();
+		if (status != CameraConfiguration::Invalid)
+			frameSize = sc.size;
+		sc.pixelFormat = origPix;
+		sc.size = origSize;
+		impl->config->validate();
+	}
