+	 * validated size so consumers (e.g. Chromium) allocate buffers of
+	 * the correct dimensions. Without this, Chromium's strict buffer
+	 * size check fails and its video capture service crashes.
+	 */
+	if (sizeRange.hStep == 0 && sizeRange.vStep == 0) {
