--- ov9734.c	2026-10-20 21:33:13.300497953 +0800
+++ ov9734.c	2026-10-21 09:20:52.994437978 +0800
@@ -5,6 +5,7 @@
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/i2c.h>
+#include <linux/gpio/consumer.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
 #include <linux/unaligned.h>
@@ -325,6 +326,7 @@
 struct ov9734 {
 	struct device *dev;
 	struct clk *clk;
+	struct gpio_desc *reset_gpio;
 
 	struct v4l2_subdev sd;
 	struct media_pad pad;
@@ -616,6 +618,20 @@
 	const struct ov9734_reg_list *reg_list;
 	int link_freq_index, ret;
 
+	/*
+	 * On Surface Laptop 3 the sensor can get stuck (black frames) after
+	 * a number of stream start/stop cycles if it is not reset. Pulse the
+	 * reset line (assert, then deassert) on every stream start. The line
+	 * is active-low, so logical 1 asserts (physical low) and logical 0
+	 * deasserts (physical high).
+	 */
+	if (ov9734->reset_gpio) {
+		gpiod_set_value_cansleep(ov9734->reset_gpio, 1);
+		msleep(2);
+		gpiod_set_value_cansleep(ov9734->reset_gpio, 0);
+		msleep(20);
+	}
+
 	link_freq_index = ov9734->cur_mode->link_freq_index;
 	reg_list = &link_freq_configs[link_freq_index].reg_list;
 	ret = ov9734_write_reg_list(ov9734, reg_list);
@@ -838,7 +854,8 @@
 
 	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
 	if (!ep)
-		return -ENXIO;
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "waiting for fwnode graph endpoint\n");
 
 	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
 	fwnode_handle_put(ep);
@@ -883,6 +900,7 @@
 	pm_runtime_disable(ov9734->dev);
 	pm_runtime_set_suspended(ov9734->dev);
 	mutex_destroy(&ov9734->mutex);
+	clk_disable_unprepare(ov9734->clk);
 }
 
 static int ov9734_probe(struct i2c_client *client)
@@ -915,10 +933,35 @@
 				     "external clock %lu is not supported",
 				     freq);
 
+	/*
+	 * On Microsoft Surface Laptop 3 (and similar platforms) the ACPI
+	 * power resources for this sensor are a no-op and the sensor is
+	 * held in reset until its reset line (active-low) is deasserted.
+	 * GPIOD_OUT_LOW drives the line physically high (deasserted).
+	 */
+	ov9734->reset_gpio = devm_gpiod_get_optional(ov9734->dev, "reset",
+						     GPIOD_OUT_LOW);
+	if (IS_ERR(ov9734->reset_gpio))
+		return dev_err_probe(ov9734->dev, PTR_ERR(ov9734->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	/*
+	 * The OV9734 needs its MCLK running before it will ACK I2C
+	 * transactions; ACPI domain PM does not enable the clock here, so
+	 * do it explicitly. A short settling delay is also required before
+	 * the chip-id read, otherwise it fails with -EREMOTEIO.
+	 */
+	ret = clk_prepare_enable(ov9734->clk);
+	if (ret)
+		return dev_err_probe(ov9734->dev, ret,
+				     "failed to enable clock\n");
+	msleep(50);
+
 	v4l2_i2c_subdev_init(&ov9734->sd, client, &ov9734_subdev_ops);
 	ret = ov9734_identify_module(ov9734);
 	if (ret) {
 		dev_err(ov9734->dev, "failed to find sensor: %d", ret);
+		clk_disable_unprepare(ov9734->clk);
 		return ret;
 	}
 
@@ -962,6 +1005,7 @@
 	pm_runtime_disable(ov9734->dev);
 	pm_runtime_set_suspended(ov9734->dev);
 	media_entity_cleanup(&ov9734->sd.entity);
+	clk_disable_unprepare(ov9734->clk);
 
 probe_error_v4l2_ctrl_handler_free:
 	v4l2_ctrl_handler_free(ov9734->sd.ctrl_handler);
